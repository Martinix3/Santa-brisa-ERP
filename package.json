{
  "name": "santa-brisa-app",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Santa Brisa ERP - Sistema de gestión empresarial",
  "author": "Santa Brisa Team",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "cross-env GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=firebase-adminsdk-fbsvc@santa-brisa-erp.iam.gserviceaccount.com next dev",
    "dev:sa": "cross-env GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=firebase-adminsdk-fbsvc@santa-brisa-erp.iam.gserviceaccount.com next dev",
    "build": "next build",
    "start": "cross-env next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:ssot-audit": "tsx src/domain/ssot.audit.ts",
    "test:exports": "vitest run tests/ssot-exports.test.ts",
    "clean": "rm -rf .next",
    "analyze": "ANALYZE=true npm run build",
    "validate": "npm run typecheck && npm run lint && npm run test && node scripts/find-route-collisions.mjs && node scripts/check-budgets.cjs",
    "validate:all": "npm run typecheck && npm run lint && npm run test && npm run audit",
    "audit:static": "node scripts/audit.js",
    "audit:runtime": "node scripts/audit-runtime.mjs",
    "audit": "npm run audit:static && npm run audit:runtime",
    "check-budgets": "node scripts/check-budgets.cjs",
    "smoke:run": "tsx src/smoke.ts",
    "smoke:admin": "tsx scripts/smoke-admin.ts",
    "genkit:start": "genkit start",
    "genkit:run": "genkit run",
    "genkit:list": "genkit list",
    "worker": "tsx src/server/queue/runner.local.ts",
    "sanity:write": "tsx scripts/sanity-write.ts",
    "db:stress": "tsx scripts/loadStressData.ts",
    "trace:map": "tsx scripts/trace-analyzer.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@fullcalendar/core": "6.1.19",
    "@fullcalendar/daygrid": "6.1.19",
    "@fullcalendar/interaction": "6.1.19",
    "@fullcalendar/list": "6.1.19",
    "@fullcalendar/react": "6.1.19",
    "@fullcalendar/timegrid": "6.1.19",
    "@genkit-ai/ai": "1.20.0",
    "@genkit-ai/googleai": "1.20.0",
    "@google-cloud/firestore": "7.11.6",
    "@google/generative-ai": "0.24.1",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-tabs": "1.1.13",
    "clsx": "2.1.1",
    "fastest-levenshtein": "1.0.16",
    "firebase": "12.3.0",
    "firebase-admin": "12.7.0",
    "firebase-functions": "5.1.1",
    "framer-motion": "12.23.22",
    "fuse.js": "7.1.0",
    "genkit": "1.20.0",
    "jszip": "3.10.1",
    "lucide-react": "0.544.0",
    "next": "15.5.4",
    "papaparse": "5.5.3",
    "pdf-lib": "1.17.1",
    "puppeteer": "24.23.0",
    "react": "19.2.0",
    "react-day-picker": "9.11.0",
    "react-dom": "19.2.0",
    "react-dropzone": "14.3.8",
    "react-hook-form": "7.63.0",
    "reactflow": "11.11.4",
    "recharts": "3.2.1",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "2.6.0",
    "xlsx": "0.18.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@next/bundle-analyzer": "15.5.4",
    "@tailwindcss/cli": "4.1.13",
    "@tailwindcss/postcss": "4.1.13",
    "@types/estree": "1.0.8",
    "@types/json-schema": "7.0.15",
    "@types/node": "24.6.2",
    "@types/papaparse": "5.3.16",
    "@types/react": "19.2.0",
    "@types/react-day-picker": "5.3.0",
    "@types/react-dom": "19.2.0",
    "@typescript-eslint/eslint-plugin": "8.44.1",
    "@typescript-eslint/parser": "8.44.1",
    "autoprefixer": "10.4.21",
    "cross-env": "7.0.3",
    "esbuild": "0.25.10",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.4",
    "eslint-plugin-regexp": "2.10.0",
    "globby": "14.1.0",
    "madge": "8.0.0",
    "postcss": "8.5.6",
    "stylelint": "16.25.0",
    "stylelint-config-standard": "36.0.1",
    "stylelint-config-tailwindcss": "0.0.7",
    "tailwindcss": "4.1.13",
    "ts-morph": "27.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vite-node": "3.2.4",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  },
  "resolutions": {
    "zod": "3.25.76"
  }
}
