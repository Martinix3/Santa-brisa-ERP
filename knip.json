{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/app/**/layout.tsx",
    "src/app/**/page.tsx",
    "src/app/**/route.ts",
    "src/app/**/loading.tsx",
    "src/app/**/default.tsx",
    "src/app/ClientProviders.tsx"
  ],
  "project": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "ignore": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/tests/**",
    "**/__tests__/**",
    "scripts/**",
    "**/*.d.ts"
  ],
  "ignoreBinaries": [
    "firebase",
    "genkit"
  ]
}
