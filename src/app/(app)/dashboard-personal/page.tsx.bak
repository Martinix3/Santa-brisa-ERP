"use client";
import React, { useState, useMemo, useCallback } from 'react';
import { toast } from 'sonner';
import { Plus, CheckCircle2, Target, Briefcase, Bell, User } from 'lucide-react';

import { useData } from '@/lib/dataprovider';
import { QuickLogDialog } from '@/features/quicklog/QuickLogDialog';
import { PageShell } from '@/components/shared/PageShell';
import { NewEventDialog } from '@/features/agenda/components/NewEventDialog';

import type { Interaction } from '@/domain/ssot';
import { getPipelineAlerts } from '@/lib/pipeline-helpers';
import { getCajasSellOut } from '@/lib/sales-helpers';

// Componentes descompuestos
import { TaskList } from '@/features/personal/components/TaskList';
import { RescheduleDialog } from '@/features/personal/components/RescheduleDialog';
import { CompactCalendar } from '@/features/personal/CompactCalendar';
import { TargetAccountsList } from '@/features/personal/components/TargetAccountsList';

type TimeRange = 'day' | 'week' | 'month';
type DialogState = 
  | { type: 'newEvent' }
  | { type: 'quickLog', accountId: string }
  | { type: 'reschedule', task: Interaction };

export default function PersonalDashboardPage() {
  const { data, currentUser, saveAllCollections } = useData();
  const [timeRange, setTimeRange] = useState<TimeRange>('day');
  const [dialog, setDialog] = useState<DialogState | null>(null);

  const filterByTimeRange = useCallback((dateStr: string | undefined) => {
    if (!dateStr) return false;
    const now = new Date();
    const targetDate = new Date(dateStr);
    
    switch (timeRange) {
      case 'day':
        return targetDate.toDateString() === now.toDateString();
      case 'week': {
        const weekStart = new Date(now);
        weekStart.setDate(now.getDate() - (now.getDay() === 0 ? 6 : now.getDay() - 1));
        weekStart.setHours(0, 0, 0, 0);
        const weekEnd = new Date(weekStart);
        weekEnd.setDate(weekStart.getDate() + 7);
        return targetDate >= weekStart && targetDate < weekEnd;
      }
      case 'month':
        return targetDate.getMonth() === now.getMonth() && targetDate.getFullYear() === now.getFullYear();
      default:
        return true;
    }
  }, [timeRange]);

  const kpis = useMemo(() => {
    if (!data || !currentUser) return null;

    const misTareas = (data.interactions || []).filter(i => i.userId === currentUser.id);
    let tareasFiltradas = misTareas.filter(i => {
      const plannedDate = (i as any).startAt || i.plannedFor || i.createdAt;
      return filterByTimeRange(plannedDate);
    });

    // En móvil, ocultar tareas vencidas
    if (typeof window !== 'undefined' && window.innerWidth < 1024) {
      const now = new Date();
      tareasFiltradas = tareasFiltradas.filter(i => {
        if (i.status === 'done') return true; // Mostrar completadas
        const plannedDate = (i as any).startAt || i.plannedFor || i.createdAt;
        if (!plannedDate) return true;
        const taskDate = new Date(plannedDate);
        return taskDate >= now; // Solo futuras y de hoy
      });
    }

    const misCuentas = (data.accounts || []).filter(a => a.ownerId === currentUser.id);
    const objetivoCajas = currentUser.kpiBaseline?.unitsSold || 100;
    const misPedidos = (data.ordersSellOut || []).filter(o => 
      o.flow === 'PLACEMENT' && misCuentas.some(a => a.id === o.accountId)
    );
    const cajasActuales = getCajasSellOut(misPedidos);
    const alerts = getPipelineAlerts(misCuentas, data.interactions || []);

    return {
      objetivoCajas,
      cajasActuales,
      cuentasAbiertas: misCuentas.filter(a => a.stage !== 'FALLIDA').length,
      alertas: alerts.length,
      tareasFiltradas
    };
  }, [data, currentUser, filterByTimeRange]);

  const handleCompleteTask = useCallback((taskId: string) => {
    if (!data) return;
    const updatedInteractions = (data.interactions || []).map(i =>
      i.id === taskId ? { ...i, status: 'done' as const, updatedAt: new Date().toISOString() } : i
    );
    saveAllCollections({ interactions: updatedInteractions });
    toast.success("Tarea completada");
  }, [data, saveAllCollections]);

  const handleRescheduleConfirm = useCallback((task: Interaction, newDate: string) => {
    if (!data) return;
    const updatedInteractions = (data.interactions || []).map(i =>
      i.id === task.id 
        ? { ...i, plannedFor: newDate, updatedAt: new Date().toISOString() } 
        : i
    );
    saveAllCollections({ interactions: updatedInteractions });
    toast.success("Tarea reprogramada");
    setDialog(null);
  }, [data, saveAllCollections]);

  if (!data || !currentUser || !kpis) {
    return (
      <PageShell title="Mi Dashboard" module="personal">
        <div className="text-muted-foreground">Cargando...</div>
      </PageShell>
    );
  }

  return (
    <PageShell 
      module="personal"
      headerContent={
        <div className="flex items-center justify-between gap-3">
          {/* Título / Icono */}
          <div className="flex items-center gap-3">
            <User className="w-5 h-5 text-muted-foreground md:hidden flex-shrink-0" />
            <h1 className="hidden md:block text-lg font-bold text-foreground">Mi Dashboard</h1>
          </div>

          {/* KPIs Compactos */}
          <div className="flex items-center gap-4 md:gap-6">
            <div className="flex items-center gap-1.5">
              <Target className="w-4 h-4 text-muted-foreground" />
              <span className="text-sm font-bold text-foreground">{kpis.objetivoCajas}</span>
            </div>
            <div className="flex items-center gap-1.5">
              <Briefcase className="w-4 h-4 text-muted-foreground" />
              <span className="text-sm font-bold text-foreground">{kpis.cuentasAbiertas}</span>
            </div>
            <div className="flex items-center gap-1.5">
              <Bell className={`w-4 h-4 ${kpis.alertas > 0 ? 'text-destructive' : 'text-muted-foreground'}`} />
              <span className={`text-sm font-bold ${kpis.alertas > 0 ? 'text-destructive' : 'text-foreground'}`}>
                {kpis.alertas}
              </span>
            </div>
          </div>

          {/* Tabs */}
          <div className="sb-tablist">
            <button 
              onClick={() => setTimeRange('day')} 
              className="sb-tab" 
              aria-selected={timeRange === 'day'}
            >
              Diaria
            </button>
            <button 
              onClick={() => setTimeRange('week')} 
              className="sb-tab" 
              aria-selected={timeRange === 'week'}
            >
              Semanal
            </button>
            <button 
              onClick={() => setTimeRange('month')} 
              className="sb-tab" 
              aria-selected={timeRange === 'month'}
            >
              Mensual
            </button>
          </div>

          {/* Botón Nuevo Evento */}
          <button
            onClick={() => setDialog({ type: 'newEvent' })}
            className="sb-btn flex-shrink-0"
            data-variant="primary"
            data-size="icon"
          >
            <Plus className="w-4 h-4" />
          </button>
        </div>
      }
    >
      <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
        {/* Calendario - Primero en móvil */}
        <div className="space-y-4 lg:hidden">
          <div className="sb-card">
            <div className="sb-card__header">
              <h2 className="sb-card__title">Calendario</h2>
            </div>
            <div className="sb-card__content">
              <CompactCalendar 
                timeRange={timeRange}
              />
            </div>
          </div>
        </div>

        {/* Columna Principal: Tareas y Objetivos */}
        <div className="lg:col-span-2 space-y-4">
          {/* Tareas */}
          <div className="sb-card">
            <div className="sb-card__header">
              <CheckCircle2 className="sb-icon" />
              <h2 className="sb-card__title">
                Tareas de la {timeRange === 'day' ? 'jornada' : timeRange}
              </h2>
            </div>
            <div className="sb-card__content">
              <TaskList
                tasks={kpis.tareasFiltradas}
                accounts={data.accounts || []}
                onComplete={handleCompleteTask}
                onReschedule={(task) => setDialog({ type: 'reschedule', task })}
              />
            </div>
          </div>

          {/* Cuentas Objetivo */}
          <div className="sb-card">
            <div className="sb-card__header">
              <Target className="sb-icon" />
              <h2 className="sb-card__title">Mis Objetivos</h2>
            </div>
            <div className="sb-card__content">
              <TargetAccountsList 
                accounts={(data.accounts || []).filter(a => a.ownerId === currentUser.id)}
              />
            </div>
          </div>
        </div>

        {/* Calendario - Desktop solamente */}
        <div className="hidden lg:block space-y-4">
          <div className="sb-card">
            <div className="sb-card__header">
              <h2 className="sb-card__title">Calendario</h2>
            </div>
            <div className="sb-card__content">
              <CompactCalendar 
                timeRange={timeRange}
              />
            </div>
          </div>
        </div>
      </div>

      {/* Modales */}
      <NewEventDialog
        open={dialog?.type === 'newEvent'}
        onOpenChange={(open) => !open && setDialog(null)}
        onSuccess={() => {
          toast.success("Evento creado");
          setDialog(null);
        }}
        dept="VENTAS"
      />

      {dialog?.type === 'quickLog' && (
        <QuickLogDialog
          open={true}
          onOpenChange={() => setDialog(null)}
          accountId={dialog.accountId}
          onSaved={() => {
            toast.success("Registro guardado");
            setDialog(null);
          }}
        />
      )}

      {dialog?.type === 'reschedule' && (
        <RescheduleDialog
          task={dialog.task}
          onClose={() => setDialog(null)}
          onConfirm={handleRescheduleConfirm}
        />
      )}
    </PageShell>
  );
}
