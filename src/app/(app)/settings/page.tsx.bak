"use client";
import React, { useState, useEffect, useMemo } from 'react';
import { PageShell } from '@/components/shared/PageShell';
import { useData } from '@/lib/dataprovider';
import { firestoreDb } from '@/lib/firebaseClient';
import { doc, updateDoc } from 'firebase/firestore';
import { toast } from 'sonner';
import { Save, Target, Users, Building2, Calendar } from 'lucide-react';
import type { User } from '@/domain/ssot';

type UserObjectives = Record<string, { unitsSold: number; revenue: number; visits: number }>;

export default function SettingsPage() {
  const { data, currentUser } = useData();
  const [saving, setSaving] = useState(false);
  const [activeTab, setActiveTab] = useState<'global' | 'comerciales' | 'distribuidores'>('global');
  
  // Objetivo global anual
  const [globalObjective, setGlobalObjective] = useState({
    year: new Date().getFullYear(),
    targetUnits: 10000,
    startDate: `${new Date().getFullYear()}-01-01`,
    endDate: `${new Date().getFullYear()}-12-31`
  });

  // Objetivos por comercial
  const [userObjectives, setUserObjectives] = useState<UserObjectives>({});

  // Cargar objetivos de todos los comerciales
  useEffect(() => {
    if (!data?.users) return;
    
    const comerciales = data.users.filter(u => u.role === 'comercial' || u.role === 'owner');
    const objectives: UserObjectives = {};
    
    comerciales.forEach(user => {
      objectives[user.id] = {
        unitsSold: user.kpiBaseline?.unitsSold || 0,
        revenue: user.kpiBaseline?.revenue || 0,
        visits: user.kpiBaseline?.visits || 0
      };
    });
    
    setUserObjectives(objectives);
  }, [data?.users]);

  // Calcular total de objetivos
  const totalObjectives = useMemo(() => {
    return Object.values(userObjectives).reduce(
      (acc, obj) => ({
        unitsSold: acc.unitsSold + obj.unitsSold,
        revenue: acc.revenue + obj.revenue,
        visits: acc.visits + obj.visits
      }),
      { unitsSold: 0, revenue: 0, visits: 0 }
    );
  }, [userObjectives]);

  const handleSaveGlobal = async () => {
    toast.info('Objetivo global guardado (funcionalidad pendiente de implementar en colección settings)');
  };

  const handleSaveComerciales = async () => {
    if (!firestoreDb || !data?.users) {
      toast.error('No conectado a Firestore');
      return;
    }

    setSaving(true);

    try {
      const db = firestoreDb; // Type narrowing
      const comerciales = data.users.filter(u => u.role === 'comercial' || u.role === 'owner');
      
      // Actualizar cada comercial
      const updates = comerciales.map(async (user) => {
        const objectives = userObjectives[user.id];
        if (!objectives) return;
        
        const userRef = doc(db, 'users', user.id);
        await updateDoc(userRef, {
          kpiBaseline: objectives,
          updatedAt: new Date().toISOString()
        });
      });

      await Promise.all(updates);
      toast.success('Objetivos de comerciales guardados correctamente');
    } catch (error) {
      console.error('Error guardando objetivos:', error);
      toast.error('Error al guardar objetivos');
    } finally {
      setSaving(false);
    }
  };

  const updateUserObjective = (userId: string, field: keyof UserObjectives[string], value: number) => {
    setUserObjectives(prev => ({
      ...prev,
      [userId]: {
        ...prev[userId],
        [field]: value
      }
    }));
  };

  if (!currentUser || !data) {
    return (
      <PageShell title="Configuración" module="admin">
        <div>Cargando...</div>
      </PageShell>
    );
  }

  const comerciales = data.users?.filter(u => u.role === 'comercial' || u.role === 'owner') || [];
  const todosUsuarios = data.users || [];

  return (
    <PageShell title="" module="personal">
      <div className="max-w-7xl mx-auto space-y-6 p-6">
        {/* Debug Info */}
        <div className="bg-blue-50 border border-blue-200 rounded-lg p-3 text-sm">
          <p><strong>Debug:</strong> Usuarios totales: {todosUsuarios.length} | Comerciales filtrados: {comerciales.length}</p>
          {todosUsuarios.length > 0 && (
            <p className="text-xs mt-1">Roles: {todosUsuarios.map(u => `${u.name} (${u.role})`).join(', ')}</p>
          )}
        </div>

        {/* Header */}
        <div className="flex items-center gap-3 mb-8">
          <div className="p-2 bg-slate-100 rounded-lg">
            <Target className="w-6 h-6 text-slate-600" />
          </div>
          <div>
            <h1 className="text-2xl font-bold">Gestión de Objetivos</h1>
            <p className="text-sm text-slate-600">Configura objetivos anuales, por comercial y por distribuidor</p>
          </div>
        </div>

        {/* Tabs */}
        <div className="border-b border-slate-200">
          <div className="flex gap-4">
            <button
              onClick={() => setActiveTab('global')}
              className={`px-4 py-2 font-medium border-b-2 transition-colors ${
                activeTab === 'global'
                  ? 'border-amber-500 text-amber-600'
                  : 'border-transparent text-slate-600 hover:text-slate-800'
              }`}
            >
              <Calendar className="w-4 h-4 inline mr-2" />
              Objetivo Global
            </button>
            <button
              onClick={() => setActiveTab('comerciales')}
              className={`px-4 py-2 font-medium border-b-2 transition-colors ${
                activeTab === 'comerciales'
                  ? 'border-amber-500 text-amber-600'
                  : 'border-transparent text-slate-600 hover:text-slate-800'
              }`}
            >
              <Users className="w-4 h-4 inline mr-2" />
              Por Comercial
            </button>
            <button
              onClick={() => setActiveTab('distribuidores')}
              className={`px-4 py-2 font-medium border-b-2 transition-colors ${
                activeTab === 'distribuidores'
                  ? 'border-amber-500 text-amber-600'
                  : 'border-transparent text-slate-600 hover:text-slate-800'
              }`}
            >
              <Building2 className="w-4 h-4 inline mr-2" />
              Por Distribuidor
            </button>
          </div>
        </div>

        {/* Tab: Objetivo Global */}
        {activeTab === 'global' && (
          <div className="bg-white border rounded-lg p-6 space-y-6">
            <div>
              <h3 className="font-semibold text-lg mb-2">Objetivo Anual de la Empresa</h3>
              <p className="text-sm text-slate-600">Define el objetivo de cajas para todo el año</p>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label className="block text-sm font-medium mb-2">Año</label>
                <input
                  type="number"
                  value={globalObjective.year}
                  onChange={(e) => setGlobalObjective(prev => ({ ...prev, year: parseInt(e.target.value) }))}
                  className="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500"
                />
              </div>

              <div>
                <label className="block text-sm font-medium mb-2">Objetivo de Cajas Anual</label>
                <input
                  type="number"
                  value={globalObjective.targetUnits}
                  onChange={(e) => setGlobalObjective(prev => ({ ...prev, targetUnits: parseInt(e.target.value) || 0 }))}
                  className="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500"
                  placeholder="10000"
                />
              </div>

              <div>
                <label className="block text-sm font-medium mb-2">Fecha de Inicio</label>
                <input
                  type="date"
                  value={globalObjective.startDate}
                  onChange={(e) => setGlobalObjective(prev => ({ ...prev, startDate: e.target.value }))}
                  className="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500"
                />
              </div>

              <div>
                <label className="block text-sm font-medium mb-2">Fecha de Fin</label>
                <input
                  type="date"
                  value={globalObjective.endDate}
                  onChange={(e) => setGlobalObjective(prev => ({ ...prev, endDate: e.target.value }))}
                  className="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500"
                />
              </div>
            </div>

            <div className="bg-amber-50 border border-amber-200 rounded-lg p-4">
              <p className="text-sm text-amber-800">
                <strong>Nota:</strong> Este objetivo se usará como referencia en los dashboards de ventas.
                Se compara con la suma de ventas reales del periodo seleccionado.
              </p>
            </div>

            <div className="flex justify-end">
              <button
                onClick={handleSaveGlobal}
                className="bg-amber-400 text-amber-900 px-6 py-2.5 rounded-lg font-bold hover:bg-amber-500 flex items-center gap-2"
              >
                <Save className="w-4 h-4" />
                Guardar Objetivo Global
              </button>
            </div>
          </div>
        )}

        {/* Tab: Por Comercial */}
        {activeTab === 'comerciales' && (
          <div className="bg-white border rounded-lg p-6 space-y-6">
            <div className="flex items-center justify-between">
              <div>
                <h3 className="font-semibold text-lg mb-2">Objetivos por Comercial</h3>
                <p className="text-sm text-slate-600">Define objetivos individuales para cada comercial</p>
              </div>
              <div className="text-right">
                <p className="text-sm text-slate-600">Total Cajas:</p>
                <p className="text-2xl font-bold text-slate-800">{totalObjectives.unitsSold.toLocaleString()}</p>
              </div>
            </div>

            <div className="overflow-x-auto">
              <table className="w-full">
                <thead>
                  <tr className="border-b bg-slate-50">
                    <th className="text-left py-3 px-4 text-sm font-semibold text-slate-600">Comercial</th>
                    <th className="text-left py-3 px-4 text-sm font-semibold text-slate-600">Objetivo Cajas (Año)</th>
                    <th className="text-left py-3 px-4 text-sm font-semibold text-slate-600">Ingresos (€)</th>
                    <th className="text-left py-3 px-4 text-sm font-semibold text-slate-600">Visitas</th>
                  </tr>
                </thead>
                <tbody>
                  {comerciales.length > 0 ? (
                    comerciales.map(user => (
                      <tr key={user.id} className="border-b hover:bg-slate-50">
                        <td className="py-4 px-4">
                          <p className="font-medium">{user.name}</p>
                          <p className="text-xs text-slate-500">{user.email}</p>
                          <span className="text-xs bg-slate-200 px-2 py-0.5 rounded">{user.role}</span>
                        </td>
                        <td className="py-4 px-4">
                          <input
                            type="number"
                            value={userObjectives[user.id]?.unitsSold || 0}
                            onChange={(e) => updateUserObjective(user.id, 'unitsSold', parseInt(e.target.value) || 0)}
                            className="w-32 px-3 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500"
                            placeholder="0"
                          />
                        </td>
                        <td className="py-4 px-4">
                          <input
                            type="number"
                            value={userObjectives[user.id]?.revenue || 0}
                            onChange={(e) => updateUserObjective(user.id, 'revenue', parseInt(e.target.value) || 0)}
                            className="w-32 px-3 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500"
                            placeholder="0"
                          />
                        </td>
                        <td className="py-4 px-4">
                          <input
                            type="number"
                            value={userObjectives[user.id]?.visits || 0}
                            onChange={(e) => updateUserObjective(user.id, 'visits', parseInt(e.target.value) || 0)}
                            className="w-32 px-3 py-2 border rounded-lg focus:ring-2 focus:ring-amber-500"
                            placeholder="0"
                          />
                        </td>
                      </tr>
                    ))
                  ) : (
                    <tr>
                      <td colSpan={4} className="py-8 text-center">
                        <p className="text-slate-600 mb-2">
                          {todosUsuarios.length === 0 
                            ? '❌ No hay usuarios en el sistema'
                            : `⚠️ No hay usuarios con role "comercial" o "owner"`
                          }
                        </p>
                        {todosUsuarios.length > 0 && (
                          <div className="text-sm text-slate-500">
                            <p className="mb-2">Usuarios encontrados ({todosUsuarios.length}):</p>
                            <ul className="space-y-1">
                              {todosUsuarios.map(u => (
                                <li key={u.id}>{u.name} - Role: <code className="bg-slate-200 px-2 py-0.5 rounded">{u.role}</code></li>
                              ))}
                            </ul>
                            <p className="mt-4 text-amber-600">
                              💡 Necesitas usuarios con role="comercial" o role="owner"
                            </p>
                          </div>
                        )}
                      </td>
                    </tr>
                  )}
                </tbody>
                <tfoot className="bg-slate-50 font-bold">
                  <tr>
                    <td className="py-3 px-4">TOTAL</td>
                    <td className="py-3 px-4">{totalObjectives.unitsSold.toLocaleString()}</td>
                    <td className="py-3 px-4">{totalObjectives.revenue.toLocaleString()}€</td>
                    <td className="py-3 px-4">{totalObjectives.visits.toLocaleString()}</td>
                  </tr>
                </tfoot>
              </table>
            </div>

            <div className="flex justify-end">
              <button
                onClick={handleSaveComerciales}
                disabled={saving}
                className="bg-amber-400 text-amber-900 px-6 py-2.5 rounded-lg font-bold hover:bg-amber-500 disabled:opacity-50 flex items-center gap-2"
              >
                <Save className="w-4 h-4" />
                {saving ? 'Guardando...' : 'Guardar Objetivos'}
              </button>
            </div>
          </div>
        )}

        {/* Tab: Por Distribuidor */}
        {activeTab === 'distribuidores' && (
          <div className="bg-white border rounded-lg p-6">
            <div className="text-center py-12">
              <Building2 className="w-16 h-16 mx-auto text-slate-300 mb-4" />
              <h3 className="font-semibold text-lg mb-2">Objetivos por Distribuidor</h3>
              <p className="text-slate-600 mb-4">
                Funcionalidad disponible próximamente
              </p>
              <p className="text-sm text-slate-500">
                Los objetivos por distribuidor se calcularán automáticamente<br/>
                en base a los objetivos de los comerciales asignados.
              </p>
            </div>
          </div>
        )}
      </div>
    </PageShell>
  );
}
