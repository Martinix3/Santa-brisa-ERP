// --- Santa Brisa: lógica de negocio (sell-out a botellas, agregados y KPIs) ---

import type {
  Account, AccountStage, TeamMember, OrderSellOut, Item, Interaction,
  PosTactic, SantaData, OrderItem
} from '@/domain/ssot';

// Re-export OrderItem as OrderLine for consistency
export type OrderLine = OrderItem;

export const inWindow = (dateStr: string, start: Date, end: Date): boolean => {
  if (!dateStr) return false;
  const time = typeof dateStr === 'string' ? +new Date(dateStr) : +new Date(Number(dateStr));
  return time >= start.getTime() && time <= end.getTime();
};

export const orderTotal = (order: OrderSellOut): number => {
    if (!order || !order.lines) return 0;
    return (order.lines || []).reduce((sum: number, line) => sum + (line.qty * (line.unitPrice || 0)), 0);
}

// ===== 0) Lógica de negocio sobre el modelo de cuenta =====

/**
 * Para una cuenta de COLOCACIÓN (commercialFlow: 'COLOCACION'), encuentra la entidad
 * del distribuidor que le sirve.
 * Devuelve null si la cuenta es de venta directa, no tiene distribuidor asignado, o no se encuentra.
 */
export function getDistributorForAccount(account: Account, allAccounts: Account[]): Account | null {
    if (!account || (account.commercialFlow !== 'COLOCACION' && account.commercialFlow !== 'AMBOS')) {
      return null;
    }

    if (!account.distributorId) return null;

    // Find the distributor account by its ID and ensure it is actually a distributor.
    const distributor = allAccounts.find(
        acc => acc.id === account.distributorId && acc.accountType === 'DISTRIBUIDOR'
    );

    return distributor || null;
}

// ===== 1) Display Helpers =====
export function accountOwnerDisplay(
  acc: Account,
  teamMembers: TeamMember[]
): string {
  if (!acc || !acc.salesRepId) return '—';

  const member = (teamMembers || []).find(u => u.id === acc.salesRepId);
  if (member) return member.name;

  return acc.salesRepId; // Fallback al ID si no se encuentra
}

// ===== 2) Conversion a botellas =====
export type BottlesOpts = {
  casesPerPallet?: number | Record<string, number>;
  countNonBottleSkusAsZero?: boolean;
};

type OrderLineWithItem = OrderSellOut['lines'][0] & { item?: Item };

function lineToBottles(line: OrderLineWithItem, opts: BottlesOpts = {}): number {
  if(!line || !line.item) return 0;
  const isBottleItem = line.item.kind === 'PRODUCT';
  if (!isBottleItem) return opts.countNonBottleSkusAsZero === false ? line.qty : 0;

  switch (line.item.uom) {
    case 'UNIT':   return line.qty;
    default: return 0;
  }
}

export function orderToBottles(order: OrderSellOut, items: Item[], opts?: BottlesOpts): number {
  return (order.lines || []).reduce((s: number, l) => {
    const item = items.find(x => x.sku === l.sku);
    return s + lineToBottles({ ...l, item }, opts);
  }, 0);
}

// ===== 3) KPIs (unitsSold = BOTELLAS) =====
export type AccountKPIs = {
  accountId: string;
  unitsSold: number;
  orderCount: number;
  avgTicket: number;
  visitsCount: number;
  visitToOrderRate?: number;
  daysSinceLastOrder?: number;
  daysSinceLastVisit?: number;
};

/**
 * Calcula los KPIs para una cuenta específica en un rango de fechas.
 */
export function computeAccountKPIs(params: {
  data: SantaData;
  accountId: string; startIso: string; endIso: string;
  lookbackDaysForConversion?: number;
}): AccountKPIs {
  const { data, accountId, startIso, endIso, lookbackDaysForConversion = 14 } = params;

  const start = new Date(startIso);
  const end = new Date(endIso);

  const accountOrders = (data.ordersSellOut || []).filter((o: OrderSellOut) =>
    o.accountId === accountId &&
    o.status === 'VALIDATED' &&
    inWindow(String(o.createdAt), start, end)
  );

  const accountInteractions = (data.interactions || []).filter((i: Interaction) => i.accountId === accountId && inWindow(String(i.createdAt), start, end));

  const unitsSold = accountOrders.reduce((s: number, o: OrderSellOut) => s + orderToBottles(o, data.items || []), 0);
  const orderCount = accountOrders.length;
  
  const totalRevenue = accountOrders.map((o: OrderSellOut) => orderTotal(o)).reduce((a: number, b: number) => a + b, 0);
  
  const avgTicket = orderCount > 0 ? totalRevenue / orderCount : 0;
  
  const visitsCount = accountInteractions.filter((i: Interaction) => i.kind === 'VISITA').length;
  const visitsInWindow = accountInteractions.filter((i: Interaction) => i.kind === 'VISITA');
  
  const ordersTimes = accountOrders.map((o: OrderSellOut) => +(new Date(o.createdAt)));
  const lookN = lookbackDaysForConversion * 24 * 3600 * 1000;
  
  const convertedVisits = visitsInWindow.filter((v: Interaction) => {
    const tv = +(new Date(v.createdAt));
    return ordersTimes.some((to: number) => to >= tv && to <= tv + lookN);
  }).length;
  
  const visitToOrderRate = visitsInWindow.length ? Number(((convertedVisits / visitsInWindow.length) * 100).toFixed(1)) : undefined;

  const allAccountOrders = (data.ordersSellOut || []).filter((o: OrderSellOut) => o.accountId === accountId && o.status === 'VALIDATED');
  const sortedOrders = allAccountOrders.sort((a: OrderSellOut, b: OrderSellOut) => +new Date(b.createdAt) - +new Date(a.createdAt));
  const lastOrder = sortedOrders.length > 0 ? sortedOrders[0] : undefined;

  const allAccountVisits = (data.interactions || []).filter((i: Interaction) => i.accountId === accountId && i.kind === 'VISITA');
  const sortedVisits = allAccountVisits.sort((a: Interaction, b: Interaction)=> +new Date(b.createdAt) - +new Date(a.createdAt));
  const lastVisit = sortedVisits.length > 0 ? sortedVisits[0] : undefined;

  const now = new Date(end);
  const daysSinceLastOrder = lastOrder ? Math.max(0, Math.round((now.getTime() - +(new Date(lastOrder.createdAt)))/(1000*3600*24))) : undefined;
  const daysSinceLastVisit = lastVisit ? Math.max(0, Math.round((now.getTime() - +(new Date(lastVisit.createdAt)))/(1000*3600*24))) : undefined;

  return { accountId, unitsSold, orderCount, avgTicket, visitsCount, visitToOrderRate, daysSinceLastOrder, daysSinceLastVisit };
}

// 4) Rollup por cuenta
export type AccountRollup = {
    accountId: string;
    hasPLVInstalled: boolean;
    lastPLVInstalledAt?: string;
    activePosTactics: number;
    lastTacticAt?: string;
}

export function computeAccountRollup(accountId: string, data: SantaData): AccountRollup {
    const accountInteractions = (data.interactions || []).filter((i: Interaction) => i.accountId === accountId);
    
    const sortedPlvVisits = accountInteractions
        .filter((i: Interaction) => i.summary?.toLowerCase().includes('plv'))
        .sort((a: Interaction, b: Interaction) => +new Date(b.createdAt) - +new Date(a.createdAt));
    const plvVisit = sortedPlvVisits.length > 0 ? sortedPlvVisits[0] : undefined;
    
    const posTactics = (data.posTactics || []).filter((t: PosTactic) => t.accountId === accountId && t.status === 'active');
    const sortedPosTactics = posTactics.sort((a: PosTactic, b: PosTactic) => +new Date(b.createdAt) - +new Date(a.createdAt));
    const lastTactic = sortedPosTactics.length > 0 ? sortedPosTactics[0] : undefined;
    
    return {
        accountId,
        hasPLVInstalled: !!plvVisit,
        lastPLVInstalledAt: plvVisit?.createdAt,
        activePosTactics: posTactics.length,
        lastTacticAt: lastTactic?.createdAt,
    };
}

export type FleetKPIs = {
  horecaAccounts: number;
  activeWithOrders: number;
  coveragePct: number;
  totalUnits: number;
  totalOrders: number;
  avgTicketAll: number;
  repurchaseRatePct: number;
  avgDaysBetweenOrders?: number;
};

export function computeFleetKPIs(params: {
  data: { items: Item[]; ordersSellOut: OrderSellOut[]; accounts: Account[]; };
  startIso: string; endIso: string;
}): FleetKPIs {
  const { data, startIso, endIso } = params;
  const start = new Date(startIso);
  const end = new Date(endIso);

  const horecaIds = data.accounts.filter((a: Account) => a.accountType === 'HORECA').map((a: Account) => a.id);
  
  const ordersInWin = data.ordersSellOut.filter((o: OrderSellOut) =>
    o.status === 'VALIDATED' && o.accountId && inWindow(String(o.createdAt), start, end) && horecaIds.includes(o.accountId)
  );

  const byAccOrders = new Map<string, OrderSellOut[]>();
  horecaIds.forEach(id => byAccOrders.set(id, []));
  ordersInWin.forEach((o: OrderSellOut) => {
    if (o.accountId) {
      byAccOrders.set(o.accountId, [...(byAccOrders.get(o.accountId) || []), o])
    }
  });

  const activeWithOrders = Array.from(byAccOrders.values()).filter(arr => (arr?.length || 0) > 0).length;

  const totalUnits = ordersInWin.reduce((s: number, o: OrderSellOut) => s + orderToBottles(o, data.items), 0);
  const totalOrders = ordersInWin.length;
  const avgTicketAll = totalOrders ? ordersInWin.map((o: OrderSellOut) => orderTotal(o)).reduce((a: number, b: number) => a + b, 0) / totalOrders : 0;

  const repurchaseRatePct = horecaIds.length
    ? (Array.from(byAccOrders.values()).filter(arr => (arr?.length || 0) >= 2).length / horecaIds.length) * 100
    : 0;

  const perAccDeltaDays: number[] = [];
  byAccOrders.forEach(arr => {
    if ((arr?.length || 0) >= 2) {
      const sorted = arr.map(o => +(new Date(o.createdAt))).sort((a: number, b: number) => a - b);
      const deltas = sorted.slice(1).map((t: number, i: number) => (t - sorted[i]) / (1000 * 3600 * 24));
      perAccDeltaDays.push(deltas.reduce((a: number, b: number) => a + b, 0) / deltas.length);
    }
  });
  
  const avgDaysBetweenOrders = perAccDeltaDays.length
    ? perAccDeltaDays.reduce((a: number, b: number) => a + b, 0) / perAccDeltaDays.length
    : undefined;

  return {
    horecaAccounts: horecaIds.length,
    activeWithOrders,
    coveragePct: horecaIds.length ? (activeWithOrders / horecaIds.length) * 100 : 0,
    totalUnits, totalOrders, avgTicketAll, repurchaseRatePct, avgDaysBetweenOrders
  };
}

import type { QcFinal } from '@/domain/ssot';
export const qcFromRow = (r: { qcStatus?: QcFinal }): QcFinal => r?.qcStatus || 'PENDING';
