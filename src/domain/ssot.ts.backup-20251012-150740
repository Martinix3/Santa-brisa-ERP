/* ------------------------------- CONVENIENCE ------------------------------ */

export const normalizeName = (s?: string) =>
  (s ?? "")
    .toLowerCase()
    .normalize("NFD")
    .replace(/\p{Diacritic}/gu, "")
    .replace(/\s+/g, " ")
    .trim();

export const buildNameNorm = (displayName?: string, city?: string) =>
  [normalizeName(displayName), normalizeName(city)].filter(Boolean).join("|");

