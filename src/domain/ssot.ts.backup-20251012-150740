// src/domain/ssot.ts
// ============================================================================
// SANTA BRISA — SSOT v6 (unificado, contacts-only)
// ----------------------------------------------------------------------------
// - Una sola colección principal: `contacts` (ORG o PERSON).
// - TODOS los módulos apuntan a `accountId` (manteniendo compatibilidad).
// - Roles múltiples por contacto: CUSTOMER | SUPPLIER | EMPLOYEE.
// - CUSTOMER: segment (HORECA/RETAIL/DISTRIBUIDOR/ONLINE/UNKNOWN) + placement.
// - EMPLOYEE: department (ADMIN/MKT/SALES/OPS).
// - Stages pipeline: LEAD, CONTACTED, SCHEDULE_APPOINTMENT, INTERESTED, SEND_INFO,
//   FOLLOW_UP, NEGOTIATION, CLOSED_WON, CLOSED_LOST, CONTACT_NEXT_SEASON, PENDIENTE, SCRAPPED.
//   Agrupados visualmente en: POTENCIAL, SEGUIMIENTO, ACTIVA, FALLIDA.
//   PENDIENTE y SCRAPPED no aparecen en el pipeline (requieren acción manual).
// - Integraciones: `externalRefs` (holdedId, gmaps.placeId, shopifyId, sendcloudId…),
//   `raw` por origen, y `links`/`geo`/`metrics` para leads.
// ============================================================================

/* ---------------------------------- ENUMS --------------------------------- */

export type ContactKind = "ORG" | "PERSON";

export type ContactRole = "CUSTOMER" | "SUPPLIER" | "EMPLOYEE";

export type CustomerSegment =
  | "HORECA"
  | "RETAIL"
  | "DISTRIBUIDOR"
  | "CATERING"
  | "ONLINE"
  | "PRIVADA"
  | "UNKNOWN";

export type Placement = "DIRECTA" | "COLOCACION";

export type Stage =
  | "LEAD"
  | "CONTACTED"
  | "SCHEDULE_APPOINTMENT"
  | "INTERESTED"
  | "SEND_INFO"
  | "FOLLOW_UP"
  | "NEGOTIATION"
  | "CLOSED_WON"
  | "CLOSED_LOST"
  | "CONTACT_NEXT_SEASON"
  | "PENDIENTE"
  | "SCRAPPED";

export type EmployeeDept = "ADMIN" | "MKT" | "SALES" | "OPS";

export type Currency = "EUR" | "USD" | "GBP" | "MXN";

/* ------------------------------ CORE: CONTACTS ---------------------------- */

export interface Contact {
  // Identificador
  id: string;

  // Naturaleza
  kind: ContactKind;             // ORG | PERSON
  roles: ContactRole[];          // multirol

  // Identidad
  displayName: string;           // SIEMPRE mostrar
  legalName?: string;            // ORG
  tradeName?: string | null;     // ORG (comercial)
  givenName?: string;            // PERSON
  familyName?: string;           // PERSON
  nameNorm: string;              // para búsqueda/dedupe

  // Identificadores fiscales/códigos
  vat?: string;                  // CIF/NIF/VAT
  taxId?: string;
  code?: string | null;          // código externo (Holded code, etc.)

  // Contacto (multi)
  emails?: Array<{ value: string; isPrimary?: boolean }>;
  phones?: Array<{ value: string; kind?: "mobile" | "landline" | "whatsapp"; isPrimary?: boolean }>;

  // Direcciones (multi)
  addresses?: Array<{
    kind?: "billing" | "shipping" | "other";
    street?: string;
    city?: string;
    province?: string;
    postalCode?: string;
    countryCode?: string;
  }>;

  // Relaciones (dentro de `contacts`)
  parentId?: string;             // PERSON → ORG (empleador/empresa)
  childrenIds?: string[];        // ORG → PERSON (equipo/personas de contacto)
  // Para cuentas representadas por un distribuidor:
  representativeOfIds?: string[]; // DISTRIBUIDOR → [ORG,HORECA,...] opcional

  // Específico por rol
  customer?: {
    segment: CustomerSegment;    // horeca/retail/distribuidor/online/unknown
    placement: Placement;        // directa/colocación
    distributorId?: string;      // si placement = COLOCACION
    tier?: "A" | "B" | "C" | "D"; // opcional de negocio
    priceListId?: string;        // referencia a prices.priceLists.id
  };

  supplier?: {
    categories?: string[];       // ej. "embalaje", "vidrio", "logística"
    leadTimeDays?: number;
  };

  employee?: {
    department: EmployeeDept;    // admin, mkt, sales, ops
    title?: string;              // cargo
    managerId?: string;          // PERSON
    startDateISO?: string;
    endDateISO?: string;
  };

  // Estado comercial transversal
  stage?: Stage;                 // LEAD/CONTACTED/.../CLOSED_WON/CLOSED_LOST/CONTACT_NEXT_SEASON/PENDIENTE/SCRAPPED
  status?: "NEW" | "ACTIVE" | "INACTIVE";

  // Geo/links/metrics (útil para leads de GMaps)
  geo?: { lat?: number; lng?: number };
  links?: {
    website?: string | null;
    url?: string | null;         // link GMaps/landing
    imageUrl?: string | null;
    socials?: {
      instagram?: string[];
      facebook?: string[];
      twitter?: string[];
      youtube?: string[];
      tiktok?: string[];
      pinterest?: string[];
      linkedin?: string[];
    };
  };
  metrics?: {
    rating?: number;             // 0..5 (GMaps totalScore)
    reviewsCount?: number;
    priceLevel?: number | null;
  };

  // Etiquetas libres
  tags?: string[];

  // Integraciones y auditoría
  source?: "HOLDed" | "CSV" | "Manual" | "Shopify" | "Sendcloud";
  externalRefs?: {
    holdedId?: string;
    shopifyId?: string;
    sendcloudId?: string;
    gmaps?: { placeId?: string | null; cid?: string | null; fid?: string | null; kgmid?: string | null };
  };
  raw?: {
    holded?: unknown;
    gmaps?: unknown;
    shopify?: unknown;
    sendcloud?: unknown;
  };

  // Tiempos
  createdAt: string;             // ISO
  updatedAt: string;             // ISO
  syncedAt?: string;             // ISO
}

/* ------------------------------- INTERACTIONS ----------------------------- */

export type InteractionKind = "LLAMADA" | "VISITA" | "EMAIL" | "WHATSAPP" | "OTRO";
export type InteractionStatus = "PROGRAMADA" | "COMPLETADA" | "CANCELADA";
export type InteractionResult = "VISITA_OK" | "VISITA_FALLIDA" | "SIN_CONTACTO" | "PENDIENTE" | "OTRO";

export interface Interaction {
  id: string;
  accountId: string;             // → contacts.id (PERSON u ORG)
  kind: InteractionKind;
  when: string;                  // ISO
  status: InteractionStatus;
  result?: InteractionResult;
  summary?: string;
  nextAt?: string;               // ISO (siguiente acción)
  createdById?: string;          // → contacts.id (empleado)
  createdAt: string;             // ISO
  updatedAt: string;             // ISO
}

