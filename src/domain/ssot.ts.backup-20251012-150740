/* ---------------------------- STAGE HELPERS ------------------------------- */

// Columnas visuales del pipeline
export type PipelineColumn = "POTENCIAL" | "SEGUIMIENTO" | "ACTIVA" | "FALLIDA";

// Mapeo Stage → Columna Visual (PENDIENTE y SCRAPPED retornan null - no visibles en pipeline)
export const getStageColumn = (stage?: Stage): PipelineColumn | null => {
  if (!stage) return "POTENCIAL";
  
  switch (stage) {
    case "LEAD":
    case "CONTACT_NEXT_SEASON":
      return "POTENCIAL";
    
    case "CLOSED_WON":
      return "ACTIVA";
    
    case "CLOSED_LOST":
      return "FALLIDA";
    
    case "PENDIENTE":
    case "SCRAPPED":
      return null; // No visibles en pipeline (requieren acción manual)
    
    case "CONTACTED":
    case "SCHEDULE_APPOINTMENT":
    case "INTERESTED":
    case "SEND_INFO":
    case "FOLLOW_UP":
    case "NEGOTIATION":
    default:
      return "SEGUIMIENTO";
  }
};

