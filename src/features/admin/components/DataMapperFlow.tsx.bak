// src/features/admin/components/DataMapperFlow.tsx
'use client';

import { useCallback, useEffect, useState } from 'react';
import ReactFlow, {
  Node,
  Edge,
  Background,
  Controls,
  MiniMap,
  useNodesState,
  useEdgesState,
  addEdge,
  Connection,
  ConnectionMode,
} from 'reactflow';
import 'reactflow/dist/style.css';
import { useLiveCollection } from '@/hooks/useLiveCollection';
import type { User, Account, PartyRole } from '@/domain/ssot';
import { SBButton } from '@/components/ui/ui-primitives';

type NodeData = {
  label: string;
  type: 'user' | 'party' | 'account';
  entityId: string;
  entity: User | Party | Account;
};

export function DataMapperFlow() {
  const { data: users = [] } = useLiveCollection<User>('users');
  const { data: parties = [] } = useLiveCollection<Party>('parties');
  const { data: accounts = [] } = useLiveCollection<Account>('accounts');
  const { data: partyRoles = [] } = useLiveCollection<PartyRole>('partyRoles');

  const [nodes, setNodes, onNodesChange] = useNodesState([]);
  const [edges, setEdges, onEdgesChange] = useEdgesState([]);
  const [selectedNode, setSelectedNode] = useState<Node<NodeData> | null>(null);
  const [saveStatus, setSaveStatus] = useState<string>('');

  // Generar nodos y edges desde los datos
  useEffect(() => {
    const newNodes: Node<NodeData>[] = [];
    const newEdges: Edge[] = [];

    // Crear nodos de usuarios (izquierda)
    users.forEach((user, i) => {
      newNodes.push({
        id: `user-${user.id}`,
        type: 'default',
        position: { x: 50, y: i * 120 + 50 },
        data: {
          label: `👤 ${user.name}\n${user.role}`,
          type: 'user',
          entityId: user.id,
          entity: user,
        },
        style: {
          background: '#10b981',
          color: 'white',
          border: '2px solid #059669',
          borderRadius: '8px',
          padding: '10px',
          fontSize: '12px',
          width: 140,
        },
      });
    });

    // Crear nodos de parties (centro)
    parties.forEach((party, i) => {
      const isDistributor = party.roles?.includes('DISTRIBUTOR');
      newNodes.push({
        id: `party-${party.id}`,
        type: 'default',
        position: { x: 350, y: i * 120 + 50 },
        data: {
          label: `🏢 ${party.name}\n${party.roles?.join(', ') || ''}`,
          type: 'party',
          entityId: party.id,
          entity: party,
        },
        style: {
          background: isDistributor ? '#3b82f6' : '#8b5cf6',
          color: 'white',
          border: isDistributor ? '2px solid #2563eb' : '2px solid #7c3aed',
          borderRadius: '8px',
          padding: '10px',
          fontSize: '12px',
          width: 160,
        },
      });
    });

    // Crear nodos de accounts (derecha)
    accounts.forEach((account, i) => {
      newNodes.push({
        id: `account-${account.id}`,
        type: 'default',
        position: { x: 650, y: i * 100 + 50 },
        data: {
          label: `🏪 ${account.name}\n${account.segment} - ${account.stage}`,
          type: 'account',
          entityId: account.id,
          entity: account,
        },
        style: {
          background: '#f59e0b',
          color: 'white',
          border: '2px solid #d97706',
          borderRadius: '8px',
          padding: '10px',
          fontSize: '12px',
          width: 180,
        },
      });
    });

    // Crear edges de partyRoles (user → party)
    // Nota: PartyRole en el SSOT actual no tiene userId directamente
    // Necesitarías extender la interfaz o usar otra colección
    partyRoles.forEach((role) => {
      if (role.data && 'salesRepId' in role.data) {
        newEdges.push({
          id: `role-${role.id}`,
          source: `user-${role.data.salesRepId}`,
          target: `party-${role.partyId}`,
          label: 'COMERCIAL',
          type: 'smoothstep',
          style: { stroke: '#10b981', strokeWidth: 2 },
          labelStyle: { fill: '#10b981', fontSize: 10 },
        });
      }
    });

    // Crear edges de accounts (party → account, account → user)
    accounts.forEach((account) => {
      // party → account
      if (account.partyId) {
        newEdges.push({
          id: `account-party-${account.id}`,
          source: `party-${account.partyId}`,
          target: `account-${account.id}`,
          label: 'ES PARTY DE',
          type: 'smoothstep',
          style: { stroke: '#8b5cf6', strokeWidth: 2 },
          labelStyle: { fill: '#8b5cf6', fontSize: 10 },
        });
      }

      // account → owner (user)
      if (account.ownerId) {
        newEdges.push({
          id: `account-owner-${account.id}`,
          source: `account-${account.id}`,
          target: `user-${account.ownerId}`,
          label: 'OWNER',
          type: 'smoothstep',
          style: { stroke: '#f59e0b', strokeWidth: 2, strokeDasharray: '5,5' },
          labelStyle: { fill: '#f59e0b', fontSize: 10 },
        });
      }

      // account → distributor (party)
      if (account.distributorPartyId) {
        newEdges.push({
          id: `account-dist-${account.id}`,
          source: `account-${account.id}`,
          target: `party-${account.distributorPartyId}`,
          label: 'VÍA DISTRIBUIDOR',
          type: 'smoothstep',
          style: { stroke: '#ef4444', strokeWidth: 2 },
          labelStyle: { fill: '#ef4444', fontSize: 10 },
        });
      }
    });

    setNodes(newNodes);
    setEdges(newEdges);
  }, [users, parties, accounts, partyRoles, setNodes, setEdges]);

  const onConnect = useCallback(
    (params: Connection) => {
      // Prevenir conexiones inválidas
      if (!params.source || !params.target) return;

      const sourceType = params.source.split('-')[0];
      const targetType = params.target.split('-')[0];

      // Solo permitir ciertas conexiones
      const validConnections = [
        { from: 'user', to: 'party' },      // PartyRole
        { from: 'account', to: 'party' },   // distributorPartyId
        { from: 'account', to: 'user' },    // ownerId
      ];

      const isValid = validConnections.some(
        (vc) => vc.from === sourceType && vc.to === targetType
      );

      if (!isValid) {
        alert('Conexión no válida. Solo puedes conectar:\n- User → Party (comercial)\n- Account → Party (distribuidor)\n- Account → User (owner)');
        return;
      }

      setEdges((eds) => addEdge({ ...params, type: 'smoothstep' }, eds));
    },
    [setEdges]
  );

  const onNodeClick = useCallback((_: React.MouseEvent, node: Node<NodeData>) => {
    setSelectedNode(node);
  }, []);

  const handleSaveChanges = async () => {
    try {
      setSaveStatus('Guardando...');
      
      // Aquí iría la lógica para actualizar Firestore basado en los edges
      // Por ahora solo mostramos un mensaje
      
      await new Promise((resolve) => setTimeout(resolve, 1000));
      setSaveStatus('✅ Cambios guardados');
      setTimeout(() => setSaveStatus(''), 3000);
    } catch (error) {
      setSaveStatus('❌ Error al guardar');
      console.error(error);
    }
  };

  return (
    <div className="flex h-[calc(100vh-200px)] gap-4">
      {/* Grafo Principal */}
      <div className="flex-1 border rounded-lg overflow-hidden bg-white">
        <ReactFlow
          nodes={nodes}
          edges={edges}
          onNodesChange={onNodesChange}
          onEdgesChange={onEdgesChange}
          onConnect={onConnect}
          onNodeClick={onNodeClick}
          connectionMode={ConnectionMode.Loose}
          fitView
        >
          <Background />
          <Controls />
          <MiniMap
            nodeColor={(node) => {
              const data = node.data as NodeData;
              if (data.type === 'user') return '#10b981';
              if (data.type === 'party') return '#3b82f6';
              return '#f59e0b';
            }}
          />
        </ReactFlow>
      </div>

      {/* Panel Lateral */}
      <div className="w-80 border rounded-lg p-4 bg-white overflow-y-auto">
        <div className="mb-4">
          <h3 className="font-semibold mb-2">Leyenda</h3>
          <div className="space-y-2 text-sm">
            <div className="flex items-center gap-2">
              <div className="w-4 h-4 bg-green-500 rounded"></div>
              <span>👤 Users (Comerciales)</span>
            </div>
            <div className="flex items-center gap-2">
              <div className="w-4 h-4 bg-blue-500 rounded"></div>
              <span>🏢 Parties (Distribuidores)</span>
            </div>
            <div className="flex items-center gap-2">
              <div className="w-4 h-4 bg-purple-500 rounded"></div>
              <span>🏢 Parties (Clientes)</span>
            </div>
            <div className="flex items-center gap-2">
              <div className="w-4 h-4 bg-amber-500 rounded"></div>
              <span>🏪 Accounts (Cuentas)</span>
            </div>
          </div>
        </div>

        <div className="mb-4">
          <h3 className="font-semibold mb-2">Conexiones</h3>
          <div className="space-y-2 text-xs">
            <div className="flex items-center gap-2">
              <div className="w-8 h-0.5 bg-green-500"></div>
              <span>User → Party (Comercial)</span>
            </div>
            <div className="flex items-center gap-2">
              <div className="w-8 h-0.5 bg-purple-500"></div>
              <span>Party → Account (Es party de)</span>
            </div>
            <div className="flex items-center gap-2">
              <div className="w-8 h-0.5 bg-amber-500" style={{ borderTop: '2px dashed' }}></div>
              <span>Account → User (Owner)</span>
            </div>
            <div className="flex items-center gap-2">
              <div className="w-8 h-0.5 bg-red-500"></div>
              <span>Account → Party (Distribuidor)</span>
            </div>
          </div>
        </div>

        {selectedNode && (
          <div className="border-t pt-4 mt-4">
            <h3 className="font-semibold mb-2">Seleccionado</h3>
            <div className="text-sm space-y-1">
              <p><strong>Tipo:</strong> {selectedNode.data.type}</p>
              <p><strong>ID:</strong> {selectedNode.data.entityId}</p>
              <pre className="text-xs bg-gray-100 p-2 rounded overflow-auto max-h-40">
                {JSON.stringify(selectedNode.data.entity, null, 2)}
              </pre>
            </div>
          </div>
        )}

        <div className="border-t pt-4 mt-4">
          <h3 className="font-semibold mb-2">Estadísticas</h3>
          <div className="text-sm space-y-1">
            <p>👤 {users.length} usuarios</p>
            <p>🏢 {parties.length} parties</p>
            <p>🏪 {accounts.length} accounts</p>
            <p>🔗 {partyRoles.length} partyRoles</p>
          </div>
        </div>

        <div className="border-t pt-4 mt-4">
          <SBButton
            onClick={handleSaveChanges}
            className="w-full"
            disabled={saveStatus.includes('Guardando')}
          >
            {saveStatus || 'Guardar Cambios'}
          </SBButton>
          <p className="text-xs text-gray-500 mt-2">
            Arrastra para reorganizar. Click para conectar nodos.
          </p>
        </div>
      </div>
    </div>
  );
}
