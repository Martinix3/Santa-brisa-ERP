// src/features/accounts/components/AccountsPipelineView.tsx
"use client";

import React, { useMemo } from 'react';
import { Account, Stage } from '@/domain/ssot';
import { AccountCard } from './AccountCard';
import { Users, Eye, CheckCircle, XCircle, Archive, UserX } from 'lucide-react';
import { useData } from '@/lib/dataprovider';

type AccountsPipelineViewProps = {
  accounts: Account[];
  data: SantaData;
};

const STAGES: { 
  key: Stage; 
  label: string; 
  color: string;
  headerBg: string;
  icon: React.ComponentType<{ className?: string }>;
}[] = [
  { 
    key: 'POTENCIAL', 
    label: 'Potenciales', 
    color: 'bg-blue-50/50',
    headerBg: 'bg-blue-100 border-blue-300',
    icon: Users
  },
  { 
    key: 'SEGUIMIENTO', 
    label: 'En Seguimiento', 
    color: 'bg-amber-50/50',
    headerBg: 'bg-amber-100 border-amber-300',
    icon: Eye
  },
  { 
    key: 'ACTIVA', 
    label: 'Activas', 
    color: 'bg-green-50/50',
    headerBg: 'bg-green-100 border-green-300',
    icon: CheckCircle
  },
  { 
    key: 'FALLIDA', 
    label: 'Perdidas', 
    color: 'bg-red-50/50',
    headerBg: 'bg-red-100 border-red-300',
    icon: XCircle
  },
  { 
    key: 'CERRADA', 
    label: 'Cerradas', 
    color: 'bg-slate-50/50',
    headerBg: 'bg-slate-100 border-slate-300',
    icon: Archive
  },
  { 
    key: 'BAJA', 
    label: 'Bajas', 
    color: 'bg-zinc-50/50',
    headerBg: 'bg-zinc-100 border-zinc-300',
    icon: UserX
  },
];

export function AccountsPipelineView({ accounts, data }: AccountsPipelineViewProps) {
  const { saveAllCollections, currentUser } = useData();

  const handleToggleTarget = async (accountId: string) => {
    if (!currentUser || !data) return;
    
    const account = accounts.find(a => a.id === accountId);
    if (!account) return;

    const isCurrentlyTarget = (account as any).isTarget || false;
    
    // Actualizar optimistamente
    const updatedAccounts = data.accounts?.map(a =>
      a.id === accountId
        ? {
            ...a,
            isTarget: !isCurrentlyTarget,
            targetUserId: !isCurrentlyTarget ? currentUser.id : undefined,
            targetedAt: !isCurrentlyTarget ? new Date().toISOString() : undefined,
            updatedAt: new Date().toISOString()
          }
        : a
    );

    saveAllCollections({ accounts: updatedAccounts });
  };

  // Agrupar y ordenar cuentas por stage
  const grouped = useMemo(() => {
    const groups: Record<Stage, Account[]> = {
      POTENCIAL: [],
      SEGUIMIENTO: [],
      ACTIVA: [],
      FALLIDA: [],
      CERRADA: [],
      BAJA: [],
    };

    accounts.forEach(account => {
      if (account.stage && groups[account.stage]) {
        groups[account.stage].push(account);
      }
    });

    // Ordenar cada grupo: objetivos primero, luego por fecha de creación
    Object.keys(groups).forEach(stage => {
      groups[stage as Stage].sort((a, b) => {
        const aIsTarget = (a as any).isTarget || false;
        const bIsTarget = (b as any).isTarget || false;
        
        // Objetivos primero
        if (aIsTarget && !bIsTarget) return -1;
        if (!aIsTarget && bIsTarget) return 1;
        
        // Luego por fecha (más reciente primero)
        return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();
      });
    });

    return groups;
  }, [accounts]);

  return (
    <div className="bg-white rounded-xl border border-slate-200 p-6 shadow-sm">
      {/* Header info */}
      <div className="mb-6">
        <h2 className="text-lg font-semibold text-slate-800 mb-2">Vista Pipeline</h2>
        <p className="text-sm text-slate-600">
          Gestiona tus cuentas por etapa del proceso comercial • Total: <span className="font-semibold">{accounts.length}</span> cuentas
        </p>
      </div>

      {/* Pipeline columns */}
      <div className="flex gap-4 overflow-x-auto pb-4">
        {STAGES.map(stage => {
          const stageAccounts = grouped[stage.key] || [];
          const Icon = stage.icon;
          
          return (
            <div
              key={stage.key}
              className="flex-shrink-0 w-80"
            >
              {/* Column header */}
              <div className={`rounded-t-xl border-2 border-b-0 p-4 ${stage.headerBg}`}>
                <div className="flex items-center justify-between mb-2">
                  <div className="flex items-center gap-2">
                    <Icon className="w-4 h-4" />
                    <h3 className="font-semibold text-sm">{stage.label}</h3>
                  </div>
                  <span className="text-xs font-bold bg-white px-2.5 py-1 rounded-full shadow-sm">
                    {stageAccounts.length}
                  </span>
                </div>
                {/* Pequeña barra de progreso visual */}
                <div className="w-full bg-white/50 rounded-full h-1 mt-2">
                  <div 
                    className="bg-current h-1 rounded-full transition-all"
                    style={{ width: `${accounts.length > 0 ? (stageAccounts.length / accounts.length) * 100 : 0}%` }}
                  />
                </div>
              </div>

              {/* Column content */}
              <div className={`border-2 border-t-0 rounded-b-xl p-3 min-h-[400px] max-h-[calc(100vh-300px)] overflow-y-auto ${stage.color}`}>
                <div className="space-y-3">
                  {stageAccounts.length > 0 ? (
                    stageAccounts.map(account => (
                      <AccountCard
                        key={account.id}
                        account={account}
                        data={data}
                        onToggleTarget={handleToggleTarget}
                      />
                    ))
                  ) : (
                    <div className="flex flex-col items-center justify-center py-12 text-center">
                      <Icon className="w-12 h-12 text-slate-300 mb-3" />
                      <p className="text-sm text-slate-500 font-medium">Sin cuentas</p>
                      <p className="text-xs text-slate-400 mt-1">en este stage</p>
                    </div>
                  )}
                </div>
              </div>
            </div>
          );
        })}
      </div>

      {/* Footer con ayuda */}
      <div className="mt-4 p-3 bg-blue-50 border border-blue-200 rounded-lg">
        <p className="text-xs text-blue-800">
          <span className="font-semibold">💡 Tip:</span> Arrastra horizontalmente para ver todas las etapas. Haz clic en una cuenta para ver detalles.
        </p>
      </div>
    </div>
  );
}
